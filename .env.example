# ---------- GeminiAI ----------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---------- PostgreSQL ----------
POSTGRES_USER=aihas
POSTGRES_PASSWORD=change_me_aihas
POSTGRES_DB=aihas
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aihas:change_me_aihas@localhost:5432/aihas

# ---------- ChromaDB ----------
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=it_kb_sops

# ---------- Backend / Security ----------
JWT_SECRET=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ---------- Automation ----------
MOCK_JIRA_URL=http://localhost:8010
N8N_WEBHOOK_URL=http://localhost:5678/webhook/
WEBHOOK_SECRET=change_me_webhook_secret

# ---------- RAG tuning ----------
RAG_MIN_VECTOR=0.72
RAG_STRONG_VECTOR=0.85